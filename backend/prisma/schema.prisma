generator client {
  provider      = "prisma-client-js"
  // native = Windows/Linux do dev; rhel-openssl-3.0.x = runtime da Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                @id @default(uuid())
  name                  String
  email                 String                @unique
  passwordHash          String
  role                  UserRole              @default(STARTUP)
  status                UserStatus            @default(ATIVO)
  lastLoginAt           DateTime?
  suspendedAt           DateTime?
  moderationReason      String?
  deletedAt             DateTime?
  trustStatus           TrustStatus           @default(NAO_AVALIADO)
  trustReason           String?
  trustUpdatedAt        DateTime?
  verifiedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  appointmentsMade      Appointment[]         @relation("AppointmentCreator")
  auditLogs             AuditLog[]
  consents              ConsentRecord[]
  investorProfile       InvestorProfile?
  receivedMessages      Message[]             @relation("MessageRecipient")
  sentMessages          Message[]             @relation("MessageSender")
  startupProfile        StartupProfile?
  passwordResets        PasswordResetToken[]
  ticketsReported       Ticket[]              @relation("TicketReporter")
  ticketsTargeted       Ticket[]              @relation("TicketTarget")
  ticketMessages        TicketMessage[]
  ticketActions         TicketAction[]
  verifications         ProfileVerification[] @relation("VerificationOwner")
  verificationsReviewed ProfileVerification[] @relation("VerificationReviewer")

  @@index([status])
  @@index([lastLoginAt])
  @@index([trustStatus])
  @@index([verifiedAt])
  @@map("users")
}

// historico imutavel de consentimentos: cada aceite ou revogacao vira uma linha
model ConsentRecord {
  id            String      @id @default(uuid())
  userId        String
  type          ConsentType
  granted       Boolean
  policyVersion String
  policyHash    String
  acceptedAt    DateTime    @default(now())
  revokedAt     DateTime?
  ip            String?
  userAgent     String?
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, acceptedAt])
  @@map("consent_records")
}

// token de redefinicao de senha: guardamos apenas o hash, com expiracao e uso unico
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model StartupProfile {
  id            String    @id @default(uuid())
  userId        String    @unique
  companyName   String
  sector        String
  description   String
  stage         String
  city          String
  state         String    @default("PE")
  website       String?
  foundedAt     DateTime?
  needs         String?
  pitchUrl      String?
  logoUrl       String?
  businessModel String?
  teamSize      Int?
  revenue       String?
  linkedin      String?
  contactEmail  String?
  phone         String?
  legalName     String?
  document      String?
  targetMarket  String?
  traction      String?
  roundTarget   Int?
  useOfFunds    String?
  competitors   String?
  accelerators  String?
  awards        String?
  instagram     String?
  hiddenAt      DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  matches       Match[]
  projects      Project[]
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sector])
  @@index([stage])
  @@index([hiddenAt])
  @@map("startups")
}

model Project {
  id        String         @id @default(uuid())
  startupId String
  title     String
  summary   String?
  status    ProjectStatus  @default(EM_ANDAMENTO)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  startup   StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@map("projects")
}

model InvestorProfile {
  id                 String    @id @default(uuid())
  userId             String    @unique
  companyName        String?
  sectorInterest     String
  stageInterest      String
  ticketMin          Int       @default(0)
  ticketMax          Int       @default(0)
  city               String?
  state              String    @default("PE")
  bio                String?
  investorType       String?
  website            String?
  linkedin           String?
  investmentThesis   String?
  preferredGeography String?
  portfolioUrl       String?
  contactEmail       String?
  phone              String?
  experience         String?
  document           String?
  instagram          String?
  dealsPerYear       Int?
  horizon            String?
  leadsRound         Boolean   @default(false)
  boardSeat          Boolean   @default(false)
  valueAdd           String?
  hiddenAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches            Match[]

  @@index([state])
  @@index([hiddenAt])
  @@map("investors")
}

model Match {
  id           String          @id @default(uuid())
  score        Float
  status       MatchStatus     @default(PENDENTE)
  reason       String?
  details      Json?
  startupId    String
  investorId   String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  appointments Appointment[]
  investor     InvestorProfile @relation(fields: [investorId], references: [id], onDelete: Cascade)
  startup      StartupProfile  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([startupId, investorId])
  @@index([score])
  @@map("matches")
}

model Message {
  id          String    @id @default(uuid())
  content     String
  senderId    String
  recipientId String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
  @@index([recipientId, readAt])
  @@map("messages")
}

model Appointment {
  id              String            @id @default(uuid())
  title           String
  description     String?
  scheduledAt     DateTime
  durationMinutes Int               @default(60)
  status          AppointmentStatus @default(AGENDADO)
  createdById     String
  matchId         String?
  createdAt       DateTime          @default(now())
  createdBy       User              @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  match           Match?            @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
  @@index([scheduledAt, durationMinutes])
  @@index([matchId, scheduledAt])
  @@map("appointments")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  userAgent String?
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity])
  @@index([userId])
  @@map("audit_logs")
}

// help desk: uma denuncia ou pedido de suporte abre um chamado.
// o alvo so entra no contexto do admin depois que o chamado existe.
model Ticket {
  id           String          @id @default(uuid())
  protocol     String          @unique
  category     TicketCategory
  subject      String
  description  String
  status       TicketStatus    @default(ABERTO)
  priority     TicketPriority  @default(NORMAL)
  resolution   String?
  reporterId   String
  targetUserId String?
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  reporter     User            @relation("TicketReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  targetUser   User?           @relation("TicketTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  messages     TicketMessage[]
  actions      TicketAction[]

  @@index([status, createdAt])
  @@index([reporterId, createdAt])
  @@index([targetUserId])
  @@map("tickets")
}

// conversa do chamado: somente quem reportou e a administracao participam
model TicketMessage {
  id        String    @id @default(uuid())
  ticketId  String
  senderId  String
  content   String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  ticket    Ticket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([senderId, readAt])
  @@map("ticket_messages")
}

// trilha das decisoes administrativas tomadas dentro de um chamado
model TicketAction {
  id        String           @id @default(uuid())
  ticketId  String
  adminId   String
  action    TicketActionType
  notes     String?
  createdAt DateTime         @default(now())
  ticket    Ticket           @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  admin     User             @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@map("ticket_actions")
}

// pedido de selo de verificacao: o usuario envia provas e a administracao decide
model ProfileVerification {
  id           String             @id @default(uuid())
  userId       String
  status       VerificationStatus @default(PENDENTE)
  legalName    String?
  document     String?
  website      String?
  linkedin     String?
  pitchUrl     String?
  evidence     String
  extraLinks   String?
  submittedAt  DateTime           @default(now())
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  user         User               @relation("VerificationOwner", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?              @relation("VerificationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, submittedAt])
  @@index([userId, status])
  @@map("profile_verifications")
}

enum VerificationStatus {
  PENDENTE
  APROVADA
  RECUSADA
}

enum TicketCategory {
  GOLPE
  PERFIL_FALSO
  ASSEDIO
  SPAM
  DADOS_INCORRETOS
  SUPORTE
  OUTRO
}

enum TicketStatus {
  ABERTO
  EM_ANALISE
  AGUARDANDO_USUARIO
  RESOLVIDO
  ARQUIVADO
}

enum TicketPriority {
  BAIXA
  NORMAL
  ALTA
  URGENTE
}

enum TicketActionType {
  ACESSO_AUTORIZADO
  OBSERVACAO
  USUARIO_SUSPENSO
  USUARIO_REATIVADO
  PERFIL_OCULTADO
  PERFIL_RESTAURADO
  GOLPE_CONFIRMADO
  GOLPE_DESCARTADO
  SUSPEITA_MARCADA
  SUSPEITA_REMOVIDA
}

enum TrustStatus {
  NAO_AVALIADO
  CONFIAVEL
  SUSPEITO
  GOLPE
}

enum UserRole {
  STARTUP
  INVESTOR
  MENTOR
  ADMIN
}

enum UserStatus {
  ATIVO
  SUSPENSO
  EXCLUIDO
}

enum ConsentType {
  TERMOS_USO
  DADOS_PESSOAIS
  COMUNICACOES
}

enum MatchStatus {
  PENDENTE
  ACEITO
  RECUSADO
}

enum AppointmentStatus {
  AGENDADO
  CONCLUIDO
  CANCELADO
}

enum ProjectStatus {
  PLANEJADO
  EM_ANDAMENTO
  CONCLUIDO
}
