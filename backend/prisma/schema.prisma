generator client {
  provider      = "prisma-client-js"
  // native = Windows/Linux do dev; rhel-openssl-3.0.x = runtime da Vercel
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String               @id @default(uuid())
  name             String
  email            String               @unique
  passwordHash     String
  role             UserRole             @default(STARTUP)
  status           UserStatus           @default(ATIVO)
  lastLoginAt      DateTime?
  suspendedAt      DateTime?
  moderationReason String?
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  appointmentsMade Appointment[]        @relation("AppointmentCreator")
  auditLogs        AuditLog[]
  consents         ConsentRecord[]
  investorProfile  InvestorProfile?
  receivedMessages Message[]            @relation("MessageRecipient")
  sentMessages     Message[]            @relation("MessageSender")
  startupProfile   StartupProfile?
  passwordResets   PasswordResetToken[]

  @@index([status])
  @@map("users")
}

// historico imutavel de consentimentos: cada aceite ou revogacao vira uma linha
model ConsentRecord {
  id            String      @id @default(uuid())
  userId        String
  type          ConsentType
  granted       Boolean
  policyVersion String
  policyHash    String
  acceptedAt    DateTime    @default(now())
  revokedAt     DateTime?
  ip            String?
  userAgent     String?
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, acceptedAt])
  @@map("consent_records")
}

// token de redefinicao de senha: guardamos apenas o hash, com expiracao e uso unico
model PasswordResetToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model StartupProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  companyName String
  sector      String
  description String
  stage       String
  city        String
  state       String    @default("PE")
  website     String?
  foundedAt   DateTime?
  needs       String?
  pitchUrl    String?
  logoUrl     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  matches     Match[]
  projects    Project[]
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sector])
  @@index([stage])
  @@map("startups")
}

model Project {
  id        String         @id @default(uuid())
  startupId String
  title     String
  summary   String?
  status    ProjectStatus  @default(EM_ANDAMENTO)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  startup   StartupProfile @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@index([startupId])
  @@map("projects")
}

model InvestorProfile {
  id             String   @id @default(uuid())
  userId         String   @unique
  companyName    String?
  sectorInterest String
  stageInterest  String
  ticketMin      Int      @default(0)
  ticketMax      Int      @default(0)
  city           String?
  state          String   @default("PE")
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches        Match[]

  @@index([state])
  @@map("investors")
}

model Match {
  id           String          @id @default(uuid())
  score        Float
  status       MatchStatus     @default(PENDENTE)
  reason       String?
  details      Json?
  startupId    String
  investorId   String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  appointments Appointment[]
  investor     InvestorProfile @relation(fields: [investorId], references: [id], onDelete: Cascade)
  startup      StartupProfile  @relation(fields: [startupId], references: [id], onDelete: Cascade)

  @@unique([startupId, investorId])
  @@index([score])
  @@map("matches")
}

model Message {
  id          String    @id @default(uuid())
  content     String
  senderId    String
  recipientId String
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  recipient   User      @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender      User      @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@map("messages")
}

model Appointment {
  id          String            @id @default(uuid())
  title       String
  description String?
  scheduledAt DateTime
  status      AppointmentStatus @default(AGENDADO)
  createdById String
  matchId     String?
  createdAt   DateTime          @default(now())
  createdBy   User              @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  match       Match?            @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
  @@index([matchId])
  @@map("appointments")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  ip        String?
  userAgent String?
  userId    String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entity])
  @@index([userId])
  @@map("audit_logs")
}

enum UserRole {
  STARTUP
  INVESTOR
  MENTOR
  ADMIN
}

enum UserStatus {
  ATIVO
  SUSPENSO
  EXCLUIDO
}

enum ConsentType {
  TERMOS_USO
  DADOS_PESSOAIS
  COMUNICACOES
}

enum MatchStatus {
  PENDENTE
  ACEITO
  RECUSADO
}

enum AppointmentStatus {
  AGENDADO
  CONCLUIDO
  CANCELADO
}

enum ProjectStatus {
  PLANEJADO
  EM_ANDAMENTO
  CONCLUIDO
}
