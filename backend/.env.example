# ===== Servidor =====
PORT=5000
NODE_ENV=development

# ===== Banco de dados =====
# dentro do compose o host é o nome do serviço "db"
DATABASE_URL="postgresql://postgres:postgres@db:5432/matchmaking?schema=public"

# ===== JWT (RNF02) =====
JWT_SECRET=troca-essa-chave-por-uma-de-verdade
JWT_EXPIRES_IN=1d

# ===== Redefinicao de senha =====
# validade do codigo enviado por e-mail (em minutos)
PASSWORD_RESET_EXPIRES_MINUTES=30

# ===== Front-end =====
# lista separada por virgula. o * cobre um nivel de subdominio, o que inclui os
# previews da Vercel (ex.: matchmaking-frontend-git-main-b1on3.vercel.app)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,https://matchmaking-frontend-ochre.vercel.app,https://matchmaking-frontend-*.vercel.app